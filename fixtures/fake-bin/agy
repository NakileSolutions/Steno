#!/usr/bin/env python3
"""Faux CLI « agy » pour les tests : --version, models, et le mode non interactif -p avec
sortie JSON. Journalise les arguments dans FAKE_AGY_LOG."""
import json, os, sys
NAME = "agy"
args = sys.argv[1:]
log = os.environ.get("FAKE_" + NAME.upper() + "_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps(args) + "\n")
if "--version" in args:
    print(NAME + " 9.9.9 (factice)"); sys.exit(0)
if args[:1] == ["models"]:
    if NAME == "agy":
        print("gemini-4-neon-xhigh            Gemini 4 Neon (XHigh)")
        print("gemini-3.8-flash-medium        Gemini 3.8 Flash")
    else:
        print("MODEL       CONTEXT"); print("grok-4.7    2M"); print("grok-4.5    256k")
    sys.exit(0)
if args[:2] == ["mcp", "list"]:
    print("[]"); sys.exit(0)
prompt = args[args.index("-p") + 1] if "-p" in args else ""
if "Compte rendu à rédiger" in prompt:
    md = "# Réunion — date\n\n## En bref\nCompte rendu factice (" + NAME + ").\n\n## Décisions\n- garder le verrou de créneau\n\n## Actions — qui / quoi / échéance\n- **Marie** — Corriger le APP-1234 — vendredi\n"
    text = md + "\n```json\n" + json.dumps({"decisions": ["garder le verrou de créneau"], "actions": [{"owner": "Marie", "text": "Corriger le APP-1234", "due": "vendredi"}]}) + "\n```\n"
else:
    text = "TL;DR: réponse factice (" + NAME + ") : le verrou de créneau est dans `src/SlotLock.kt:42`, ticket APP-1234."
if NAME == "agy":
    print(json.dumps({"conversation_id": "conv-1", "status": "SUCCESS", "response": text, "num_turns": 1}))
else:
    sid = args[args.index("-s") + 1] if "-s" in args else "s-1"
    print(json.dumps({"result": text, "session_id": sid}))
