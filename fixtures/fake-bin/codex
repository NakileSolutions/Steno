#!/usr/bin/env python3
"""Fake "codex" CLI for tests: --version, `mcp list`, and `exec [resume <id>] --json ... -`
(prompt read on stdin, JSONL events on stdout, last message written to the file given by
--output-last-message). Refuses to run without the read-only sandbox and the neutralised MCP
servers, like a guard. Logs its arguments to FAKE_CODEX_LOG."""
import json, os, sys

args = sys.argv[1:]
log = os.environ.get("FAKE_CODEX_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps(args) + "\n")
if "--version" in args:
    print("codex-cli 9.9.9 (fake)"); sys.exit(0)
if args[:2] == ["mcp", "list"]:
    print("[]"); sys.exit(0)
if args[:1] != ["exec"]:
    print("fake codex: unsupported command " + " ".join(args), file=sys.stderr); sys.exit(2)


def emit(event):
    print(json.dumps(event), flush=True)


def value_after(flag):
    return args[args.index(flag) + 1] if flag in args and args.index(flag) + 1 < len(args) else None


thread = args[2] if args[1:2] == ["resume"] and len(args) > 2 else "th-1"
emit({"type": "thread.started", "thread_id": thread})
sandboxed = any(args[i] == "--sandbox" and args[i + 1] == "read-only" for i in range(len(args) - 1))
if not sandboxed or "mcp_servers={}" not in args:
    emit({"type": "turn.failed", "error": {"message": "fake codex: read-only sandbox and mcp_servers={} required"}})
    sys.exit(1)
prompt = sys.stdin.read() if args[-1:] == ["-"] else ""
if "Compte rendu à rédiger" in prompt:
    md = "# Réunion — date\n\n## En bref\nCompte rendu factice (codex).\n\n## Décisions\n- garder le verrou de créneau\n\n## Actions — qui / quoi / échéance\n- **Marie** — Corriger le APP-1234 — vendredi\n"
    text = md + "\n```json\n" + json.dumps({"decisions": ["garder le verrou de créneau"], "actions": [{"owner": "Marie", "text": "Corriger le APP-1234", "due": "vendredi"}]}) + "\n```\n"
else:
    text = "TL;DR: réponse factice (codex) : le verrou de créneau est dans `src/SlotLock.kt:42`, ticket APP-1234."
emit({"type": "item.completed", "item": {"id": "i1", "type": "agent_message", "text": text}})
emit({"type": "turn.completed", "usage": {}})
last = value_after("--output-last-message")
if last:
    with open(last, "w") as f:
        f.write(text)
